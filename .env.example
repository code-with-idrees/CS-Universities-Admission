## Example environment variables for local development
# Copy this file to .env and edit the values before running `npm run dev`.

# Enable sample fallback responses (works without any API key)
VITE_GEMINI_ALLOW_FALLBACK=true

# Optional: Add your Gemini API key for live AI responses
# Get it free from https://aistudio.google.com/
# Leave empty to use sample responses
VITE_GEMINI_API_KEY=

# Notes:
# - Variables must start with VITE_ to be exposed to the Vite client.
# - This file is in .gitignore and won't be committed to Git
# - After editing, restart the dev server to pick up changes: npm run dev
